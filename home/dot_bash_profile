# ~/.bash_profile — managed by dotfiles (https://github.com/mikecuoco/dotfiles)
# Main entry point for login shells.
# Do NOT edit this file directly; put local overrides in ~/.extra.
# Re-run `chezmoi apply` (or `dotfiles-sync` on Code Ocean) after changing the source.

# ── Shell options ─────────────────────────────────────────────────────────────

# Enable history expansion: typing !!<space> expands to the last command
bind Space:magic-space 2>/dev/null

# History: large, timestamped, deduped, appended (not overwritten)
export HISTTIMEFORMAT='%F %T '
export HISTCONTROL="ignoredups"
export HISTSIZE=100000
export HISTFILESIZE=$HISTSIZE
export HISTIGNORE="&:[ ]*:exit:ls:bg:fg:history:clear"
type shopt &>/dev/null && shopt -s histappend cmdhist

# Append each command to the history file as soon as it runs. Not exported, and
# guarded, so nested shells do not stack copies.
case "${PROMPT_COMMAND:-}" in
    *"history -a"*) ;;
    *) PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
esac

# Better globbing and cd
type shopt &>/dev/null && shopt -s nocaseglob cdspell globstar 2>/dev/null

# ── Man page colors ────────────────────────────────────────────────────────────
export LESS_TERMCAP_mb=$'\E[01;31m'       # begin blinking
export LESS_TERMCAP_md=$'\E[01;38;5;74m'  # begin bold
export LESS_TERMCAP_me=$'\E[0m'           # end mode
export LESS_TERMCAP_se=$'\E[0m'           # end standout-mode
export LESS_TERMCAP_so=$'\E[38;5;246m'    # begin standout-mode (info box)
export LESS_TERMCAP_ue=$'\E[0m'           # end underline
export LESS_TERMCAP_us=$'\E[04;38;5;146m' # begin underline

# ── Common dotfiles ────────────────────────────────────────────────────────────
for _df_file in "$HOME"/.{exports,aliases,functions,bash_prompt}; do
    [ -r "$_df_file" ] && source "$_df_file"
done
unset _df_file

# ── Platform overlay ───────────────────────────────────────────────────────────
# chezmoi writes the active profile name to ~/.config/dotfiles/profile
# and installs overlay files as ~/.exports.<profile>, ~/.aliases.<profile>, etc.
# cluster, codeocean and codespace build on the linux layer, whose overlay
# chezmoi installs only for those profiles, so it is loaded first when present.
_DF_PROFILE="${DOTFILES_PROFILE:-$(cat "$HOME/.config/dotfiles/profile" 2>/dev/null)}"
_df_layers="$_DF_PROFILE"
if [ -n "$_DF_PROFILE" ] && [ "$_DF_PROFILE" != linux ] && [ -r "$HOME/.exports.linux" ]; then
    _df_layers="linux $_DF_PROFILE"
fi
for _df_layer in $_df_layers; do
    for _df_file in "$HOME"/.{exports,aliases,functions}."$_df_layer"; do
        [ -r "$_df_file" ] && source "$_df_file"
    done
done
unset _DF_PROFILE _df_layers _df_layer _df_file

# ── Node.js (fnm) ─────────────────────────────────────────────────────────────
if command -v fnm >/dev/null 2>&1; then
    eval "$(fnm env --use-on-cd)"
fi

# ── Jump tool: zoxide (preferred) or z ────────────────────────────────────────
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
elif [ -f "$HOME/.z.sh" ]; then
    source "$HOME/.z.sh"
fi

# ── Bash completion ───────────────────────────────────────────────────────────
# The bash-completion framework itself is loaded by the platform overlay.
command -v gh &>/dev/null && eval "$(gh completion -s bash)" 2>/dev/null
[ -f "$HOME/.git-completion.bash" ] && source "$HOME/.git-completion.bash"
# Enable `g` alias tab-completion (same as git)
if type __git_complete &>/dev/null; then
    __git_complete g __git_main 2>/dev/null
fi

# ── Local overrides (not in git) ──────────────────────────────────────────────
[ -f "$HOME/.extra" ] && source "$HOME/.extra"

[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"
