#!/bin/sh
# Back up pre-existing unmanaged dotfiles before the first apply on this machine.
#
# The legacy installer created <file>.dotfiles-backup.<utc-timestamp> whenever it
# was about to replace something it did not already own (the former Python installer's backup path).
# chezmoi has no equivalent -- it overwrites silently -- so this restores the
# safety net for the one moment it matters: the first install onto a machine that
# already has dotfiles. run_once_ means chezmoi runs it exactly once per machine.
#
# Only leaf targets are considered. Backing up a source *directory* would mean
# copying whole trees such as ~/.config or ~/.vim, which can be enormous and
# which chezmoi never replaces wholesale -- it only writes the individual files
# inside them.
#
# Target names are derived from the source tree rather than hardcoded, so this
# cannot drift as files are added. Nested `chezmoi` calls are NOT used: they
# deadlock on the persistent-state lock while an apply is in progress.
set -eu

SRC="${CHEZMOI_SOURCE_DIR:?}"
DEST="{{ .chezmoi.destDir }}"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
COUNT_FILE="$(mktemp)"
printf '0' > "$COUNT_FILE"
LIST="$(mktemp)"

# Every managed file, relative to the source root. Paths containing a dot-prefixed
# segment are chezmoi's own (.chezmoiignore, .chezmoitemplates/, ...) and are
# never installed as targets.
find "$SRC" -type f | sed "s|^$SRC/||" | grep -Ev '(^|/)\.' > "$LIST" || true

while IFS= read -r rel; do
    [ -n "$rel" ] || continue

    target="$DEST"
    skip=0
    # Translate each path segment: strip chezmoi attribute/type prefixes, then
    # map dot_<name> back to .<name>.
    oldIFS=$IFS; IFS=/
    # shellcheck disable=SC2086
    set -- $rel
    IFS=$oldIFS
    for seg in "$@"; do
        case "$seg" in run_*) skip=1; break ;; esac
        while :; do
            case "$seg" in
                encrypted_*|private_*|readonly_*|empty_*|executable_*|symlink_*|create_*|modify_*)
                    seg="${seg#*_}" ;;
                *) break ;;
            esac
        done
        case "$seg" in
            dot_*) seg=".${seg#dot_}" ;;
        esac
        seg="${seg%.tmpl}"
        target="$target/$seg"
    done
    [ "$skip" -eq 0 ] || continue

    # Nothing there, or already ours -- nothing to preserve.
    [ -e "$target" ] || continue
    [ -d "$target" ] && continue
    if [ -L "$target" ]; then
        case "$(readlink "$target")" in "$SRC"/*) continue ;; esac
    fi

    backup="$target.dotfiles-backup.$STAMP"
    [ -e "$backup" ] && continue
    cp "$target" "$backup"
    printf '%s' "$(( $(cat "$COUNT_FILE") + 1 ))" > "$COUNT_FILE"
    echo "  backed up ${target#$DEST/} -> $(basename "$backup")"
done < "$LIST"

n="$(cat "$COUNT_FILE")"
rm -f "$LIST" "$COUNT_FILE"
[ "$n" -gt 0 ] && echo "  ($n unmanaged file(s) preserved before first apply)"
exit 0
