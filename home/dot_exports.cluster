# ~/.exports.cluster — HPC/cluster-specific environment variables
# Sourced after ~/.exports.linux on cluster systems.

# micromamba / conda installed to $HOME (no-root HPC install)
if [ -d "$HOME/conda/bin" ]; then
    export PATH="$HOME/conda/bin:$PATH"
fi
if [ -d "$HOME/micromamba" ]; then
    export MAMBA_ROOT_PREFIX="$HOME/micromamba"
    export PATH="$HOME/micromamba/bin:$PATH"
fi

# Initialize conda shell integration when micromamba is not installed
if [ -f "$HOME/conda/etc/profile.d/conda.sh" ] && [ ! -d "$HOME/micromamba" ]; then
    source "$HOME/conda/etc/profile.d/conda.sh"
fi

# Slurm / PBS helpers — uncomment if needed
# export SBATCH_ACCOUNT="${SBATCH_ACCOUNT:-your-account}"
