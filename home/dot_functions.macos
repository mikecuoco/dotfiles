#!/usr/bin/env bash
# ~/.functions.macos — macOS-specific shell functions
# Sourced after ~/.functions on macOS via the platform overlay mechanism.

# ── Finder integration ────────────────────────────────────────────────────────

# cd into the frontmost Finder window
cdf() {
    cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')"
}

# ── Camera ───────────────────────────────────────────────────────────────────

# Show which process is using the FaceTime / iSight camera
camerausedby() {
    echo "Checking who is using the camera… 📷"
    local used
    used="$(lsof | grep -w "AppleCamera\|USBVDC\|iSight" | awk '{print $2}' | xargs ps 2>/dev/null)"
    echo -e "Recent camera uses:\n${used:-none}"
}

# ── Network ──────────────────────────────────────────────────────────────────

# Show local IP addresses for all network interfaces
localip() {
    local purple="\x1B[35m" reset="\x1B[m"
    networksetup -listallhardwareports | \
        sed -E "s/Hardware Port: (.*)/${purple}\1${reset}/g" | \
        sed -E "s/Device: (en.*)$/ipconfig getifaddr \1/e" | \
        sed -E "s/Ethernet Address:/📘 /g" | \
        sed -E "s/(VLAN Configurations)|=+//g"
}

# ── Media conversion ─────────────────────────────────────────────────────────
# Requires: ffmpeg, gifsicle

# Convert a video to an animated GIF
# Usage: gifify input.mov [--good]
gifify() {
    if [[ -z "$1" ]]; then
        echo "Usage: gifify <input_movie.mov> [--good]"
        return 1
    fi
    if [[ $2 == '--good' ]]; then
        ffmpeg -i "$1" -r 10 -vcodec png out-static-%05d.png
        convert -verbose +dither -layers Optimize -resize 900x900\> out-static*.png GIF:- | \
            gifsicle --colors 128 --delay=5 --loop --optimize=3 --multifile - > "$1.gif"
        rm -f out-static*.png
    else
        ffmpeg -i "$1" -s 600x400 -pix_fmt rgb24 -r 10 -f gif - | \
            gifsicle --optimize=3 --delay=3 > "$1.gif"
    fi
}

# Convert a video to WebM
# Requires: ffmpeg with libvpx + libvorbis
webmify() {
    ffmpeg -i "$1" -vcodec libvpx -acodec libvorbis -isync -copyts \
        -aq 80 -threads 3 -qmax 30 -y "$2" "$1.webm"
}

# ── Shell management ──────────────────────────────────────────────────────────

# Switch the default shell (target must be listed in /etc/shells)
# Example: shellswitch bash
shellswitch() {
    chsh -s "$(brew --prefix)/bin/$1"
}

# ── VPN (Cisco AnyConnect + 1Password) ───────────────────────────────────────
# Requires: op (1Password CLI), Cisco Secure Client / AnyConnect CLI
# Add the VPN item IDs to ~/.extra (never commit those values).
#
# Example ~/.extra entry:
#   export OP_UCSD_VPN_ID="your-1password-item-uuid"
#   export OP_SALK_VPN_ID="your-1password-item-uuid"
#   export OP_ALLEN_VPN_ID="your-1password-item-uuid"

connect() {
    local credential_name group gateway item_id pass username vpn_cli

    case "$1" in
        ucsd)
            credential_name=OP_UCSD_VPN_ID
            group=0
            gateway=vpn.ucsd.edu
            item_id="${OP_UCSD_VPN_ID:-}"
            ;;
        salk)
            credential_name=OP_SALK_VPN_ID
            group=1
            gateway=vpnfp.salk.edu
            item_id="${OP_SALK_VPN_ID:-}"
            ;;
        allen)
            credential_name=OP_ALLEN_VPN_ID
            group=
            gateway=vpn.alleninstitute.org
            item_id="${OP_ALLEN_VPN_ID:-}"
            ;;
        *)
            echo "Usage: connect ucsd|salk|allen" >&2
            return 1
            ;;
    esac

    if command -v vpn &>/dev/null; then
        vpn_cli="$(command -v vpn)"
    elif [[ -x /opt/cisco/secureclient/bin/vpn ]]; then
        vpn_cli=/opt/cisco/secureclient/bin/vpn
    elif [[ -x /opt/cisco/anyconnect/bin/vpn ]]; then
        vpn_cli=/opt/cisco/anyconnect/bin/vpn
    else
        echo "Error: Cisco Secure Client VPN CLI was not found" >&2
        return 127
    fi

    if [[ -z "$item_id" ]]; then
        echo "Error: set $credential_name in ~/.extra" >&2
        return 1
    fi
    if ! command -v op &>/dev/null; then
        echo "Error: 1Password CLI (op) is not installed" >&2
        return 127
    fi

    if ! username="$(op item get "$item_id" --fields username)"; then
        echo "Error: could not retrieve the VPN username from 1Password" >&2
        return 1
    fi
    if ! pass="$(op item get "$item_id" --reveal --fields password)"; then
        echo "Error: could not retrieve the VPN password from 1Password" >&2
        return 1
    fi

    if [[ -n "$group" ]]; then
        printf "%s\n%s\n%s\ny" "$group" "$username" "$pass" | \
            "$vpn_cli" -s connect "$gateway"
    else
        printf "%s\n%s\ny" "$username" "$pass" | \
            "$vpn_cli" -s connect "$gateway"
    fi
}

# ── SSH Tunnelling ─────────────────────────────────────────────────────────────

# Forward a remote port to localhost
# Usage: tunnel <hostname> <port>
tunnel() {
    ssh "${DOTFILES_USER:-$USER}@$1" -L "$2:localhost:$2"
}
