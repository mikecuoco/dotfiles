#!/bin/sh
# Install required packages if absent.
# run_onchange_: chezmoi reruns this whenever the script content changes,
# so adding a package here ensures it gets installed on next apply.
set -eu

install_zoxide() {
    command -v zoxide >/dev/null 2>&1 && return 0
    if command -v brew >/dev/null 2>&1; then
        echo "==> brew install zoxide"
        brew install zoxide
    else
        echo "==> installing zoxide via official installer (~/.local/bin)"
        curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | sh
    fi
}

install_eza() {
    command -v eza >/dev/null 2>&1 && return 0
    if command -v brew >/dev/null 2>&1; then
        echo "==> brew install eza"
        brew install eza
        return 0
    fi
    # eza publishes no macOS assets, so anything else needs cargo.
    if [ "$(uname -s)" != "Linux" ]; then
        if command -v cargo >/dev/null 2>&1; then
            echo "==> cargo install eza"
            cargo install eza
        else
            echo "==> no brew or cargo for eza; ls/ll/la fall back to GNU ls"
        fi
        return 0
    fi
    # The glibc build first, deliberately: it resolves owners and groups through
    # NSS, so accounts served by LDAP/SSSD -- every cluster account -- print as
    # names. The musl asset is static-pie and so cannot load libnss_sss at all;
    # it sees only /etc/passwd and falls back to numeric UIDs and GIDs. Its one
    # advantage is not needing glibc, and the gnu asset's floor is 2.18 (2013),
    # below any machine this runs on, so musl is a last resort rather than the
    # safe default. aarch64 ships no musl asset either way.
    case "$(uname -m)" in
        x86_64|amd64)   _targets="x86_64-unknown-linux-gnu x86_64-unknown-linux-musl" ;;
        aarch64|arm64)  _targets="aarch64-unknown-linux-gnu" ;;
        *)
            echo "==> no eza binary for $(uname -m); ls/ll/la fall back to GNU ls"
            return 0
            ;;
    esac
    mkdir -p "$HOME/.local/bin"
    for _target in $_targets; do
        echo "==> installing eza ($_target) via GitHub release (~/.local/bin)"
        _url="https://github.com/eza-community/eza/releases/latest/download/eza_${_target}.tar.gz"
        _tmp="$(mktemp -d)"
        # The tarball holds a single member, ./eza.
        if curl -fsSL "$_url" | tar -xzf - -C "$_tmp"; then
            install -m 755 "$_tmp/eza" "$HOME/.local/bin/eza"
        fi
        rm -rf "$_tmp"
        # A binary needing a newer glibc than the host has installs fine and
        # then fails to exec, so confirm it runs before accepting it.
        if "$HOME/.local/bin/eza" --version >/dev/null 2>&1; then
            case "$_target" in
                *-musl)
                    echo "==> note: musl eza cannot read NSS; LDAP owners/groups show as IDs"
                    ;;
            esac
            unset _target _targets _url _tmp
            return 0
        fi
        rm -f "$HOME/.local/bin/eza"
    done
    echo "==> eza install failed; ls/ll/la fall back to GNU ls"
    unset _target _targets _url _tmp
}

install_uv() {
    if ! command -v uv >/dev/null 2>&1; then
        if command -v brew >/dev/null 2>&1; then
            echo "==> brew install uv"
            brew install uv
        else
            echo "==> installing uv via official installer (~/.local/bin)"
            curl -LsSf https://astral.sh/uv/install.sh | sh
        fi
    fi
    # Ensure the PATH env-setup script exists for non-Homebrew installs.
    # The curl installer writes it; installs via other means (conda, modules,
    # manual copy) do not.
    if ! command -v brew >/dev/null 2>&1 && [ ! -f "$HOME/.local/bin/env" ]; then
        echo "==> creating ~/.local/bin/env"
        cat > "$HOME/.local/bin/env" << 'ENVEOF'
#!/bin/sh
case ":${PATH}:" in
    *:"$HOME/.local/bin":*) ;;
    *) export PATH="$HOME/.local/bin:${PATH}" ;;
esac
ENVEOF
    fi
}

install_node() {
    command -v node >/dev/null 2>&1 && return 0
    if command -v brew >/dev/null 2>&1; then
        echo "==> brew install node"
        brew install node
    else
        echo "==> installing node via fnm (~/.local/bin)"
        curl -fsSL https://fnm.vercel.app/install | bash -s -- \
            --install-dir "$HOME/.local/bin" --skip-shell
        "$HOME/.local/bin/fnm" install --lts
        "$HOME/.local/bin/fnm" default lts-latest
        eval "$("$HOME/.local/bin/fnm" env)"
    fi
}

install_awscli() {
    command -v aws >/dev/null 2>&1 && return 0
    if command -v brew >/dev/null 2>&1; then
        echo "==> brew install awscli"
        brew install awscli
    else
        echo "==> installing awscli via official installer (~/.local/bin)"
        _arch="$(uname -m)"
        _url="https://awscli.amazonaws.com/awscli-exe-linux-${_arch}.zip"
        curl -fsSL "$_url" -o /tmp/awscliv2.zip
        unzip -q /tmp/awscliv2.zip -d /tmp/awscliv2
        /tmp/awscliv2/aws/install --install-dir "$HOME/.local/aws-cli" --bin-dir "$HOME/.local/bin"
        rm -rf /tmp/awscliv2.zip /tmp/awscliv2
        unset _arch _url
    fi
}

install_claude_code() {
    command -v claude >/dev/null 2>&1 && return 0
    [ -x "$HOME/.local/bin/claude" ] && return 0
    if command -v brew >/dev/null 2>&1; then
        echo "==> brew install --cask claude-code"
        brew install --cask claude-code
    else
        echo "==> installing claude-code via native installer (~/.local/bin)"
        curl -fsSL https://claude.ai/install.sh | bash
    fi
}

# Applying into a throwaway $HOME -- what the test suite does, and what CI
# does -- starts from empty chezmoi state, so run_onchange_ has no record of
# this script and reruns it for every apply. The tests assert what apply
# *renders*, never that packages got installed, and on a machine missing any of
# these the unguarded script would fetch it from the network once per apply.
# Unset on a real machine, where installing is the entire point.
if [ -n "${DOTFILES_SKIP_PACKAGE_INSTALL:-}" ]; then
    echo "==> DOTFILES_SKIP_PACKAGE_INSTALL set, skipping package installation"
    exit 0
fi

install_zoxide
install_eza
install_uv
install_node
install_awscli
install_claude_code
