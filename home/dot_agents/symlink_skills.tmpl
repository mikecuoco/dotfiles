{{- /*
  ~/.agents/skills -> the Claude skills directory.

  Codex and Claude Code read the same portable <name>/SKILL.md layout, and the
  two trees were byte-identical when they were maintained as separate copies.
  Linking them means they cannot drift, and bio-skill installation only has one
  destination to write.

  On Code Ocean the Claude tree lives in the versioned capsule while ~/.agents
  stays in $HOME, so the link crosses roots. The capsule pass never installs
  this file -- .chezmoiignore restricts that pass to .claude -- so this always
  renders for $HOME and only the target differs.
*/ -}}
{{- $capsule := env "DOTFILES_CAPSULE_DIR" | default "/root/capsule" -}}
{{- if and (has "codeocean" (index .layers .profile)) (stat $capsule) -}}
{{ $capsule }}/.claude/skills
{{- else -}}
{{ .chezmoi.homeDir }}/.claude/skills
{{- end -}}
