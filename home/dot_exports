# ~/.exports — managed by dotfiles
# Common environment variables for all platforms.

# ── Editor ────────────────────────────────────────────────────────────────────
# Prefer neovim → vim → vi
export EDITOR
EDITOR="$(command -v nvim 2>/dev/null || command -v vim 2>/dev/null || echo 'vi')"
export VISUAL="$EDITOR"

# Don't clear the screen after quitting a manual page
export MANPAGER="less -X"

# ── Locale ────────────────────────────────────────────────────────────────────
export LC_ALL="en_US.UTF-8"
export LANG="en_US.UTF-8"

# ── LS_COLORS ─────────────────────────────────────────────────────────────────
# Uses ~/.dircolors if present; gdircolors (GNU, via Homebrew) falls back to dircolors
if command -v gdircolors &>/dev/null; then
    eval "$(gdircolors -b "$HOME/.dircolors" 2>/dev/null)"
elif command -v dircolors &>/dev/null; then
    eval "$(dircolors -b "$HOME/.dircolors" 2>/dev/null)"
fi

# ── PATH additions ────────────────────────────────────────────────────────────
# Add personal bin directories if they exist. Skip ones already on PATH so
# nested shells do not keep prepending duplicates.
for _d in "$HOME/.cargo/bin" "$HOME/code/bin" "$HOME/.local/bin" "$HOME/bin"; do
    case ":$PATH:" in
        *":$_d:"*) ;;
        *) [ -d "$_d" ] && export PATH="$_d:$PATH" ;;
    esac
done
unset _d

# ── Claude Code ───────────────────────────────────────────────────────────────
# Subscription OAuth (CLAUDE_CODE_OAUTH_TOKEN) is the preferred auth method.
# Unset the API key so it cannot shadow OAuth even if injected by the environment.
unset ANTHROPIC_API_KEY
