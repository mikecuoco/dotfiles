" ~/.vimrc — managed by dotfiles. Plain defaults, no plugins.

set nocompatible
filetype plugin indent on
syntax on
set background=dark
silent! colorscheme habamax         " built in since Vim 9; keep the default otherwise
let mapleader=","

" Keep backups, swap and undo files out of the working tree.
for s:dir in ['backups', 'swaps', 'undo']
  call mkdir(expand('~/.vim/' . s:dir), 'p', 0700)
endfor
set backupdir=~/.vim/backups// directory=~/.vim/swaps// undodir=~/.vim/undo//
set undofile

" Editing
set encoding=utf-8 nobomb
set autoindent expandtab smarttab shiftwidth=2 softtabstop=2
set backspace=indent,eol,start
set nojoinspaces nostartofline
set nomodeline modelines=0          " modelines are a security risk
set hidden history=1000

" Display
set number ruler cursorline laststatus=2 showcmd
set nowrap scrolloff=3 sidescrolloff=3
set splitbelow splitright
set mouse=a title lazyredraw visualbell noerrorbells shortmess+=I
set list listchars=tab:›\ ,trail:·,nbsp:_
set wildmenu wildmode=list:longest
set wildignore+=.DS_Store,*/.git/*,*/node_modules/*,*.pyc

" Search
set hlsearch incsearch ignorecase smartcase gdefault

" Mappings
nnoremap Y y$
map <C-j> <C-W>j
map <C-k> <C-W>k
map <C-h> <C-W>h
map <C-l> <C-W>l
nnoremap <silent> <leader>qs :nohlsearch<CR>
nnoremap <leader>ss :%s/\s\+$//e<CR>
command! W write

" Return to the last cursor position when reopening a file.
augroup dotfiles_vimrc
  autocmd!
  autocmd BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g`\"" | endif
augroup END
