# Nature-compatible manuscript default at final single-column size (89 mm).
# Use 7.2047 inches for Nature's 183 mm double-column width.

figure.figsize: 3.5039, 2.6279
figure.dpi: 120
figure.titlesize: 7

font.size: 6
axes.titlesize: 7
axes.labelsize: 7
xtick.labelsize: 6
ytick.labelsize: 6
legend.fontsize: 6
legend.title_fontsize: 7

axes.linewidth: 0.75
lines.linewidth: 0.75
lines.markersize: 4

savefig.format: pdf
savefig.dpi: 300
