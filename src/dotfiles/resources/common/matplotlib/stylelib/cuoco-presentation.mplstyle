# 16:9 presentation figure default.

figure.figsize: 12, 6.75
figure.dpi: 120
figure.titlesize: 22
figure.titleweight: normal

font.size: 14
axes.titlesize: 18
axes.titleweight: normal
axes.titlepad: 8
axes.labelsize: 16
axes.labelpad: 5
xtick.labelsize: 13
ytick.labelsize: 13
legend.fontsize: 12
legend.title_fontsize: 13

axes.linewidth: 1.25
lines.linewidth: 2
lines.markersize: 6

savefig.format: png
savefig.dpi: 200
