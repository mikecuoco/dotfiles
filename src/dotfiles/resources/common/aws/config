# ~/.aws/config — AWS CLI configuration
# Managed by dotfiles. Edit: src/dotfiles/resources/common/aws/config
#
# To find account IDs: open the SSO portal in a browser and log in.
#   https://identitycenter.amazonaws.com/ssoins-7907e1277625ab90
# To authenticate after filling in account IDs:
#   aws sso login --use-device-code --sso-session allen

[sso-session allen]
sso_start_url           = https://identitycenter.amazonaws.com/ssoins-7907e1277625ab90
sso_region              = us-west-2
sso_registration_scopes = sso:account:access

[default]
sso_session    = allen
sso_account_id = REPLACE_WITH_ACCOUNT_ID
sso_role_name  = StorageWorkgroupRW
region         = us-west-2
output         = json

[profile storage]
sso_session    = allen
sso_account_id = REPLACE_WITH_ACCOUNT_ID
sso_role_name  = StorageWorkgroupRW
region         = us-west-2
output         = json

[profile sensitive]
sso_session    = allen
sso_account_id = REPLACE_WITH_SENSITIVE_ACCOUNT_ID
sso_role_name  = HighlySensitiveSEAADStorageRW
region         = us-west-2
output         = json

# Add more profiles as needed:
# [profile another-account]
# sso_session    = allen
# sso_account_id = 123456789012
# sso_role_name  = StorageWorkgroupRW
# region         = us-west-2
# output         = json
